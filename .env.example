JWT_SECRET=replace-with-a-long-random-secret
# Simple self-hosted dashboard (no login) — set to true for Vercel/Cloudflare Pages
DISABLE_AUTH=true

# Hosted provider or an OpenAI-compatible self-hosted endpoint.
# For Ollama, use http://localhost:11434/v1 and omit LLM_API_KEY.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# For Vercel/Cloudflare, all endpoints auto-resolve to same origin:
# /api/chatbots, /api/public/chat/:id, /chatbot-widget.js via vercel.json/wrangler.toml rewrites